# 复制成 .env 后填写；.env 已被 .gitignore 忽略，不要提交
#
# 留空 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY 时，harness 会自动降级为 MockModel
# 并在运行记录里写 missing-config-fallback-mock（见 ADR-0002）。这是预期行为，不是错误。

# --- DeepSeek（OpenAI 兼容接口）---
# 只需要填 key；BASE_URL 默认是官方端点 https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-flash

# 思考模式开关。默认 disabled —— 实测开着时模型会把 max_tokens 全部烧在 reasoning 上、
# content 返回空串（4096 和 16384 都一样），对 tactic 生成完全不可用。见 ADR-0005。
# 想复现「思考模式」就改成 enabled。
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=1024

# 如果本机靠本地代理上网，填代理地址；留空则直连（也会读 HTTPS_PROXY 环境变量）
# 实测这台机器曾在 127.0.0.1:7897 开过代理，但代理软件未运行时该端口不监听。
# DEEPSEEK_PROXY=http://127.0.0.1:7897

# --- Lean 编译环境（见 ADR-0001）---
# 默认值写在 harness/config.py，通常不用改
# MINIF2F_ENV_PROJECT=D:\bianma\code\大创\sgs-reap\sgslean
# MINIF2F_RAW=D:\bianma\code\大创\sgs-reap\data\raw\miniF2F-lean4

# --- 编译超时（秒）---
# 实测 import Mathlib 单次约 240 s，留足余量
# MINIF2F_COMPILE_TIMEOUT=1800
# 补救阶段的墙钟上限（实测 7 题约需 1700 s）
# MINIF2F_REMEDY_TIMEOUT=2400

# --- 计费（人民币 / 百万 token）---
# 不填就一律报「未配置」，绝不会用编造的价格算出一个像真的数字。
# 请按你自己的账单金额填写。
# DEEPSEEK_PRICE_IN_CNY_PER_MTOK=
# DEEPSEEK_PRICE_OUT_CNY_PER_MTOK=
